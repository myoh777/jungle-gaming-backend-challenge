      "enabled": true,
      "serviceAccountClientId": "wallet-admin",
      "realmRoles": [
        "wallet-internal",
        "default-roles-wagering"
      ]
    },
    {
      "username": "service-account-no-role-client",
      "enabled": true,
      "serviceAccountClientId": "no-role-client",
      "realmRoles": [
        "default-roles-wagering"
      ]
    }
  ]

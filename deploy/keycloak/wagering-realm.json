            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "service-account-provider-alpha",
      "enabled": true,
      "serviceAccountClientId": "provider-alpha",
      "realmRoles": [
        "wagering-provider",
        "default-roles-wagering"
      ]
    },
    {
      "username": "service-account-provider-beta",
      "enabled": true,
      "serviceAccountClientId": "provider-beta",
      "realmRoles": [
        "wagering-provider",
        "default-roles-wagering"

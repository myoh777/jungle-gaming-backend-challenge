# Example configuration for running the server outside Docker (go run ./cmd/server)
# against the dependencies started by `docker compose up -d postgres keycloak localstack`.
# Values are local-only placeholders; never commit real credentials.

INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=20s

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable
DB_MAX_CONNS=20
AUTO_MIGRATE=false

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events

OIDC_ISSUER=http://localhost:8081/realms/wagering
OIDC_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api

# HMAC keys (one per provider) that the trusted gateway uses to sign SQS
# messages. This file holds FICTITIOUS local-only keys. In real environments
# inject the JSON from a secret store, either as SQS_PROVIDER_SIGNING_KEYS or as
# a mounted file in SQS_PROVIDER_SIGNING_KEYS_FILE (set only one).
SQS_PROVIDER_SIGNING_KEYS_FILE=deploy/local/fake-sqs-signing-keys.json

CONSUMER_ENABLED=true
CONSUMER_NAME=wager-transactions-consumer
CONSUMER_WAIT_SECONDS=10
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_MAX_MESSAGES=10
CONSUMER_PROCESS_TIMEOUT=15s
CONSUMER_RETRY_BASE=2s
CONSUMER_RETRY_MAX=60s

PUBLISHER_ENABLED=true
PUBLISHER_POLL_INTERVAL=500ms
PUBLISHER_BATCH_SIZE=50
PUBLISHER_LEASE=30s
PUBLISHER_RETRY_BASE=1s
PUBLISHER_RETRY_MAX=1m

REFERENCE_WORKER_ENABLED=true
REFERENCE_POLL_INTERVAL=1s
REFERENCE_BATCH_SIZE=50
REFERENCE_RETRY_BASE=2s
REFERENCE_RETRY_MAX=5m
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=1h

# Only if your LocalStack image requires an account token.
LOCALSTACK_AUTH_TOKEN=
